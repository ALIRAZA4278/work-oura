# ============================================================
# Supabase (Project Settings -> API se copy karein)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ============================================================
# Auth — session JWT sign karne ke liye (kam se kam 32 chars)
# Naya banane ke liye: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ============================================================
AUTH_SECRET=generate_karein_node_-e_crypto.randomBytes(48).toString('hex')

# ============================================================
# App
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# Email (job application notifications)
# ============================================================
RESEND_API_KEY=
NM_EMAIL_USER=
NM_EMAIL_PW=
